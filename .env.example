# Copy to a local secrets file that is NOT committed.
# Stripe test keys go in WooCommerce → Settings → Payments → Stripe
# (official WooCommerce Stripe plugin). Never hardcode keys in theme/plugin PHP.

STRIPE_TEST_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_TEST_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_TEST_WEBHOOK_SECRET=whsec_xxxxxxxx

# Local site URL (Docker default)
WP_URL=http://localhost:8081
